        '</div>';
      wrapper.querySelector('.bg-surface-container').textContent = text;
      feed.appendChild(wrapper);
    }

    function handleQuery(queryText) {
      const trimmed = queryText.trim();
      if (!trimmed) return;
      appendUserBubble(trimmed);
      const reply =
        offlineReplies[trimmed] ||
        'I have offline notes for West Bengal trains, ₹ budgets, homestays, and local food! Try tapping one of the quick-reply chips below.';
