    };

    function appendUserBubble(text) {
      const wrapper = document.createElement('div');
      wrapper.className = 'flex items-end justify-end gap-space-sm';
      wrapper.innerHTML =
        '<div class="flex flex-col items-end gap-space-xs max-w-[80%]">' +
        '<div class="bg-primary text-on-primary px-space-md py-space-sm rounded-xl rounded-tr-sm font-body-md text-body-md shadow-sm"></div>' +
        '</div>';
      wrapper.querySelector('div > div').textContent = text;
      feed.appendChild(wrapper);
    }

    function appendAnandaBubble(text) {
      const wrapper = document.createElement('div');
      wrapper.className = 'flex items-start gap-space-sm';
      wrapper.innerHTML =
        '<div class="w-8 h-8 rounded-full bg-secondary text-on-secondary flex items-center justify-center shrink-0 mt-space-xs shadow-sm">' +
